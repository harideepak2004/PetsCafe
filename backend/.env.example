# Copy to backend/.env for local development. Never commit the real .env.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave all empty for SQLite locally.
# Option A: one URL (Render Postgres -> Connections -> External Database URL)
DATABASE_URL=
# Option B: separate values (used only if DATABASE_URL is empty)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Frontend origin(s) allowed to call the API, and the public site URL (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Staff login, created/updated automatically on start (used for the staff dashboard and /admin)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cafe rules
CAFE_OPEN_HOUR=10
CAFE_CLOSE_HOUR=21
CAFE_SEATS_PER_SLOT=20
CAFE_BOOKING_DAYS_AHEAD=30

# Gmail App Password (https://myaccount.google.com/apppasswords).
# Leave EMAIL_HOST_USER empty to print emails to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Pets Cafe <you@gmail.com>
